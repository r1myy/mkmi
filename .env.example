# Base PostgreSQL (Supabase en production : Project Settings > Database > Connection string)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mkmi
# Secret long et aléatoire (openssl rand -hex 32)
PAYLOAD_SECRET=change-me
# URL publique du site (SEO, liens absolus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stockage des fichiers en ligne (Supabase Storage, voir .env.production.example). Laisser vide en local.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
