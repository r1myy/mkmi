# Valeurs de PRODUCTION (mkmi.pixora.ca). À saisir dans Hostinger › Variables d’environnement.
# Copie locale facultative : .env.production.local (ignoré par Git), utilisée par scripts/transfert-production.mjs.
# Ne jamais publier ces valeurs (GitHub, courriel, chat).

# Supabase › Connect › « Session pooler » (compatible IPv4). Remplacer [MOT-DE-PASSE] et garder les paramètres à la fin.
DATABASE_URL=postgresql://postgres.[REF-PROJET]:[MOT-DE-PASSE]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Secret neuf, différent du local : dans le Terminal, `openssl rand -hex 32`
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=https://mkmi.pixora.ca

# Supabase › Storage › S3 Configuration (bucket privé « mkmi-fichiers »)
S3_BUCKET=mkmi-fichiers
S3_ENDPOINT=https://[REF-PROJET].storage.supabase.co/storage/v1/s3
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
